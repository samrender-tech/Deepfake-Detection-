# Agent layer (A1-A8). Agents are optional: every one has a deterministic fallback.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_TOKEN_BUDGET=200000

# Serving
DDETECT_RUN_DIR=runs/baseline_a/seed0
DDETECT_DEVICE=auto
API_KEYS=dev-key-change-me
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://ddetect:ddetect@localhost:5432/ddetect
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ddetect
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MAX_UPLOAD_MB=100
MAX_DURATION_S=60
RETENTION_HOURS=24
