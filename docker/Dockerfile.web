# The frontend as a standalone nginx image, for deployments that serve it from
# a CDN or a separate host. The API image also embeds the built assets, so this
# is only needed when the two are scaled independently.

FROM node:20-slim AS build
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://localhost/ >/dev/null || exit 1
