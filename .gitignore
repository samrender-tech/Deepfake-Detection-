# Data and artefacts. These patterns are ANCHORED with a leading slash on
# purpose: a bare `data/` also matches `ddetect/data/` and `configs/data/`,
# which silently excludes the entire data package and every Hydra data config
# from the repository. A clean clone then fails to import, with no clue why.
/data/
/processed/
/runs/
/results/
/audit/
/mlruns/
/outputs/
*.pt
*.pth
*.onnx
*.ckpt

# Media: never commit video or audio except the tiny synthetic fixtures.
*.mp4
*.avi
*.mov
*.mkv
*.wav
!tests/fixtures/videos/*.mp4

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# node
node_modules/
/web/dist/
*.tsbuildinfo
# Playwright output: traces, videos and screenshots from failed runs.
/web/test-results/
/web/playwright-report/
/web/blob-report/

# secrets
.env
.env.*
!.env.example

# os / editor
.DS_Store
.idea/
.vscode/

# latex build products
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg
/paper/*.pdf
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.synctex.gz
# Figures are GENERATED by experiments/figures.py, never drawn. Committing
# them would let a stale figure outlive the run that produced it.
/paper/figs/

# agent scratch -- proposals are working notes, not deliverables
/proposals/*
!/proposals/.gitkeep
